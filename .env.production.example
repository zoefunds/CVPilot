# Copy to your orchestrator's secret store. Never commit the filled version.

# --- Environment ---
APP_ENV=production
APP_DEBUG=false
APP_NAME=CVPilot

# --- Security ---
# Generate with: openssl rand -base64 48
APP_SECRET_KEY=REPLACE_ME_WITH_64_CHAR_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRES_MIN=720

# --- Public origins ---
APP_FRONTEND_ORIGIN=https://cvpilot-theta.vercel.app

# --- Datastores ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/cvpilot
REDIS_URL=redis://default:PASSWORD@HOST:6379/0

# --- GenLayer ---
LLM_BACKEND=genlayer
GENLAYER_STUDIO_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=0x51D4DC0eF0759721216b829a844f6c80325ED15b
MIN_SUBMIT_BALANCE_WEI=100000000000000000

# --- Object storage (if external) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/uploads

# --- Email (Brevo) ---
BREVO_API_KEY=REPLACE_ME
BREVO_SENDER_EMAIL=preciousmofeoluwa@gmail.com
BREVO_SENDER_NAME=CVPilot

# --- Password reset ---
PASSWORD_RESET_TOKEN_TTL_MIN=30
EMAIL_VERIFICATION_TOKEN_TTL_MIN=1440

# --- Observability ---
LOG_LEVEL=INFO
