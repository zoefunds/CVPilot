# Copy to Vercel project env. Never commit the filled version.

# Public API origin used by the browser. Same-origin via /api proxy by
# default; override only if you intentionally bypass the Vercel rewrite.
NEXT_PUBLIC_API_BASE_URL=/api

# Public site origin, used for share/verify links.
NEXT_PUBLIC_SITE_ORIGIN=https://cvpilot.app

# Contract address for the public verify page deep links.
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=0x539552a2C7023e28086532C57Ee945963C4AcAEc
NEXT_PUBLIC_GENLAYER_EXPLORER=https://studio.genlayer.com/explorer

# Build target.
NODE_ENV=production
